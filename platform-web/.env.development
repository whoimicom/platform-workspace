# 应用端口（仅 Vite 读取，不加 VITE_ 前缀暴露给浏览器）
APP_PORT=3000

# 项目名称
VITE_APP_TITLE=platform-web

# 部署基础路径（访问地址：http://localhost:3000/platform-web/）
VITE_BASE_URL=/platform-web/

# 代理前缀
VITE_API_BASE=/dev-api

# 接口地址（开发代理转发目标，仅 Vite 读取）
API_PROXY_TARGET=http://localhost:8000      # 本地
# API_PROXY_TARGET=https://api.youlai.tech  # 线上

# Mock 开关（关闭后 /dev-api 请求代理到 platform-api）
VITE_MOCK_ENABLED=false
