{
  "name": "platform-web",
  "description": "Vue3 + Vite + TypeScript + Element-Plus 的后台管理模板，基于 vue3-element-admin 的开发模板",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:mock": "vite build --mode mock",
    "deploy": "node deploy.mjs",
    "type-check": "vue-tsc --noEmit",
    "lint:check": "eslint src mock vite.config.ts uno.config.ts eslint.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss,css,json}\" \"mock/**/*.ts\" \"*.{ts,cjs,mjs,json,yaml}\"",
    "style:check": "stylelint \"src/**/*.{css,scss,vue}\"",
    "check": "pnpm run lint:check && pnpm run format:check && pnpm run style:check",
    "audit:prod": "pnpm audit --prod --registry=https://registry.npmjs.org",
    "lint:eslint": "eslint --cache \"src/**/*.{vue,ts,js}\" --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache \"**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier && pnpm run lint:stylelint",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json}": [
      "prettier --write"
    ],
    "*.{vue,html}": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^15.0.0",
    "@wangeditor-next/editor": "^6.5.1",
    "@wangeditor-next/editor-for-vue": "^6.5.1",
    "animate.css": "^4.1.1",
    "axios": "^1.21.1",
    "codemirror": "^5.65.21",
    "codemirror-editor-vue3": "^2.8.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.8",
    "exceljs": "^4.4.0",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^8.4.2",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "qs": "^6.17.1",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.45",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@iconify/utils": "^3.1.7",
    "@types/codemirror": "^5.60.18",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/nprogress": "^0.2.3",
    "@types/path-browserify": "^1.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.2",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-prettier": "^5.1.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "unocss": "^66.12.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.7",
    "vite-plugin-mock-dev-server": "^2.7.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": "https://github.com/whoimicom/platform-workspace.git",
  "author": "whoimi",
  "license": "MIT"
}
